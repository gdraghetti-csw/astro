---

const token = Astro.cookies.get("auth")?.value;

let user = null;
let initials = "";

if (token) {
  
  try {
    const payload = JSON.parse(
      Buffer.from(token.split(".")[1], "base64").toString()
    );

    user = payload;

    if (user?.name) {
      initials = user.name
        .split(" ")
        .map((n) => n[0])
        .join("")
        .toUpperCase()
        .slice(0, 2);
    }
  } catch {}

}

const colors = ["bg-[#011E41]", "bg-[#153F70]", "bg-[#00DF6D]"];
const color = colors[user?.name.length % colors.length];
---

<div style="width: 100%" class="flex items-center justify-beetween gap-6 w-full">

{user && (
  <div >
    <!-- AVATAR -->
    <button id="userButton" class="flex gap-2 items-center">
      <span
        class=`bg-[#4E668B] w-8 h-8 rounded-full text-white flex items-center justify-center text-sm font-semibold`
      >
        {initials}
      </span>
      <span class="flex gap-0 items-center">
        {user?.name}
        <span class="grayscale opacity-50">🔻</span>
      </span>
    </button>

        <!-- MENU -->
    <div
      id="userMenu"
      class="hidden absolute left-5 top-15 mt-2 bg-[#f6f7f9] border border-gray-400 rounded shadow p-2 hover:bg-green-50"
    >
      <a 
        href="/api/auth/logout"
        class="block px-3 py-1 text-sm"
      >
        Logout
      </a>
    </div>

  </div>
)}

<!-- LOGO -->
  <a href="/" class="flex items-center gap-2" style="margin: auto">
    <img src="/img-docs/shape_logo_dark.svg" alt="My Docs" class="h-6" />
  </a>

<!-- SEARCH -->
<div class="relative">
  <input
    id="searchInput"
    type="text"
    placeholder="Cerca..."
    class="border px-3 py-1 rounded w-fit"
  />

  <div
    id="searchResults"
    class="absolute top-10 right-0 w-80 min-h-[22em] bg-white border rounded shadow hidden z-50"
  ></div>
</div>




</div>  

<script>
  // Raggruppiamo la logica dentro una funzione per evitare errori se gli elementi non esistono nella pagina
  function initMenu() {
    const button = document.getElementById("userButton");
    const menu = document.getElementById("userMenu");

    // Se l'utente non è loggato, gli elementi non esistono. Interrompiamo l'esecuzione.
    if (!button || !menu) return;

    // Gestione del click sul bottone per mostrare/nascondere
    button.addEventListener("click", (e) => {
      e.stopPropagation(); // Impedisce al click di propagarsi immediatamente al document
      menu.classList.toggle("hidden");
    });

    // Gestione del click all'esterno per chiudere il menu
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!button.contains(target) && !menu.contains(target)) {
        menu.classList.add("hidden");
      }
    });
  }

  // Esegui la logica al caricamento della pagina
  initMenu();

  document.addEventListener("DOMContentLoaded", () => {
    console.log("Search attiva ✅");

    const client = window.algoliasearch(
      import.meta.env.PUBLIC_ALGOLIA_APP_ID,
      import.meta.env.PUBLIC_ALGOLIA_SEARCH_KEY
    );

    const index = client.initIndex("docs");

    const input = document.getElementById("searchInput");
    const resultsBox = document.getElementById("searchResults");

    if (!input || !resultsBox) {
      console.log("Input non trovato");
      return;
    }

    input.addEventListener("input", async (e) => {
      const query = e.target.value.trim();

      if (!query) {
        resultsBox.innerHTML = "";
        resultsBox.classList.add("hidden");
        return;
      }

      const res = await index.search(query);

      if (!res.hits.length) {
        resultsBox.innerHTML = "<p class='p-2'>Nessun risultato</p>";
        resultsBox.classList.remove("hidden");
        return;
      }
      
      // ✅ rimuove duplicati per URL
      const uniqueHits = Object.values(
        res.hits.reduce((acc, hit) => {
          if (!acc[hit.url]) {
            acc[hit.url] = hit;
          }
          return acc;
        }, {})
      );

      resultsBox.innerHTML = uniqueHits
      .map(hit => `
        <a href="${hit.url}" class="block px-3 py-2 hover:bg-gray-100 text-sm">
          <strong>${hit.title}</strong>          
          <p class="text-xs opacity-70">
            ${hit.content.slice(0, 80)}...
          </p>
        </a>
      `)
      .join("");

  
console.log(res);


      resultsBox.classList.remove("hidden");
    });
  });
</script>

<!-- ✅ SCRIPT LIBRERIA -->
<script src="https://cdn.jsdelivr.net/npm/algoliasearch@4/dist/algoliasearch-lite.umd.js"></script>